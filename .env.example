# PMS 部署环境变量模板
# 用法： cp .env.example .env  →  填入生产值  →  docker compose up -d --build
# 切勿把真实 .env 提交到版本库。

# ---------- 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pms
DB_USER=root
DB_PASS=替换为强密码

# ---------- 安全 ----------
# JWT 签名密钥：≥32 字符的随机串，例如 openssl rand -base64 48
JWT_SECRET=替换为openssl-rand-base64-48-生成的随机串
# admin 初始密码；启动后也可经 PUT /api/v1/staff/1/password 修改
ADMIN_PASSWORD=替换为强密码

# ---------- 日志 ----------
# 滚动日志目录（容器内 /app/logs，建议挂卷持久化）
LOG_PATH=logs
